prefix=${pcfiledir}/@SDRKIT_PC_TO_PREFIX@
includedir=${prefix}/@SDRKIT_INSTALL_INCLUDEDIR@
libdir=${prefix}/@SDRKIT_INSTALL_LIBDIR@
datadir=${prefix}/@SDRKIT_INSTALL_DATADIR@

