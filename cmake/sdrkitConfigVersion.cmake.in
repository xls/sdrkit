# sdrkit @SDRKIT_VERSION@ for @SDRKIT_RUST_TARGET@. A request is met at this version or below it with the same major
# version; before 1.0, with the same minor version too. The libraries are for programs with
# @SDRKIT_SIZEOF_VOID_P@-byte pointers.
set(PACKAGE_VERSION "@SDRKIT_VERSION@")
set(PACKAGE_VERSION_COMPATIBLE FALSE)
set(PACKAGE_VERSION_EXACT FALSE)
if(NOT PACKAGE_FIND_VERSION VERSION_GREATER PACKAGE_VERSION
   AND "${PACKAGE_FIND_VERSION_MAJOR}" STREQUAL "@SDRKIT_VERSION_MAJOR@"
   AND ("@SDRKIT_VERSION_MAJOR@" STREQUAL "0" AND "${PACKAGE_FIND_VERSION_MINOR}" STREQUAL "@SDRKIT_VERSION_MINOR@"
        OR NOT "@SDRKIT_VERSION_MAJOR@" STREQUAL "0"))
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
endif()
if(NOT PACKAGE_FIND_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
endif()
if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
    set(PACKAGE_VERSION_EXACT TRUE)
endif()
if(CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL "@SDRKIT_SIZEOF_VOID_P@")
    set(PACKAGE_VERSION "@SDRKIT_VERSION@ (@SDRKIT_SIZEOF_VOID_P@-byte pointers)")
    set(PACKAGE_VERSION_UNSUITABLE TRUE)
endif()
