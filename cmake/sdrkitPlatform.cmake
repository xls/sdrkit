# The facts of each platform that the build of sdrkit needs: the Rust target triple for the CMake target, the file
# names of the libraries, and the system libraries of the static library. CMakeLists.txt includes it.

# Sets `out` to the Rust target triple for the platform that CMake builds for, or to an empty string for the host.
function(sdrkit_detect_rust_target out)
    set(triple "")
    if(CMAKE_SYSTEM_NAME STREQUAL "Android")
        set(abi "${CMAKE_ANDROID_ARCH_ABI}")
        if(NOT abi)
            set(abi "${ANDROID_ABI}")
        endif()
        if(abi STREQUAL "arm64-v8a")
            set(triple aarch64-linux-android)
        elseif(abi STREQUAL "armeabi-v7a")
            set(triple armv7-linux-androideabi)
        elseif(abi STREQUAL "x86_64")
            set(triple x86_64-linux-android)
        elseif(abi STREQUAL "x86")
            set(triple i686-linux-android)
        else()
            message(FATAL_ERROR "sdrkit: no Rust target for the Android ABI '${abi}'. Set SDRKIT_RUST_TARGET.")
        endif()
    elseif(CMAKE_SYSTEM_NAME STREQUAL "iOS")
        list(LENGTH CMAKE_OSX_ARCHITECTURES count)
        if(count GREATER 1)
            message(FATAL_ERROR "sdrkit: build one architecture at a time (CMAKE_OSX_ARCHITECTURES), or set "
                "SDRKIT_RUST_TARGET.")
        endif()
        set(arch "${CMAKE_OSX_ARCHITECTURES}")
        if(NOT arch)
            set(arch arm64)
        endif()
        if(CMAKE_OSX_SYSROOT MATCHES "[Ss]imulator")
            if(arch STREQUAL "x86_64")
                set(triple x86_64-apple-ios)
            else()
                set(triple aarch64-apple-ios-sim)
            endif()
        else()
            set(triple aarch64-apple-ios)
        endif()
    elseif(APPLE)
        list(LENGTH CMAKE_OSX_ARCHITECTURES count)
        if(count GREATER 1)
            message(FATAL_ERROR "sdrkit: build one architecture at a time (CMAKE_OSX_ARCHITECTURES), or set "
                "SDRKIT_RUST_TARGET. lipo joins two builds into one universal library.")
        endif()
        if(CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
            set(triple aarch64-apple-darwin)
        elseif(CMAKE_OSX_ARCHITECTURES STREQUAL "x86_64")
            set(triple x86_64-apple-darwin)
        endif()
    elseif(WIN32 AND CMAKE_GENERATOR_PLATFORM)
        if(CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64")
            set(triple aarch64-pc-windows-msvc)
        elseif(CMAKE_GENERATOR_PLATFORM STREQUAL "Win32")
            set(triple i686-pc-windows-msvc)
        endif()
    elseif(CMAKE_CROSSCOMPILING)
        message(FATAL_ERROR "sdrkit: CMake cross-compiles for ${CMAKE_SYSTEM_NAME} ${CMAKE_SYSTEM_PROCESSOR}. Set "
            "SDRKIT_RUST_TARGET to the Rust target triple of that platform.")
    endif()
    set(${out} "${triple}" PARENT_SCOPE)
endfunction()

# Sets the variables <prefix>_STATIC, <prefix>_SHARED, <prefix>_IMPLIB and <prefix>_SONAME to the file names that
# cargo gives the libraries on `triple`, and the name that a program records for the shared library.
function(sdrkit_library_names triple prefix)
    set(implib "")
    set(soname "")
    if(triple MATCHES "-windows-msvc")
        set(static sdrkit.lib)
        set(shared sdrkit.dll)
        set(implib sdrkit.dll.lib)
    elseif(triple MATCHES "-windows-gnu")
        set(static libsdrkit.a)
        set(shared sdrkit.dll)
        set(implib libsdrkit.dll.a)
    elseif(triple MATCHES "-apple-")
        set(static libsdrkit.a)
        set(shared libsdrkit.dylib)
        set(soname "@rpath/libsdrkit.dylib")
    else()
        set(static libsdrkit.a)
        set(shared libsdrkit.so)
        set(soname libsdrkit.so)
    endif()
    set(${prefix}_STATIC "${static}" PARENT_SCOPE)
    set(${prefix}_SHARED "${shared}" PARENT_SCOPE)
    set(${prefix}_IMPLIB "${implib}" PARENT_SCOPE)
    set(${prefix}_SONAME "${soname}" PARENT_SCOPE)
endfunction()

# Sets `out` to the system libraries that the static library needs on `triple`, as CMake link items. These are the
# lists that `cargo rustc -p sdrkit-host-ffi -- --print native-static-libs` prints; tools/package.sh writes the printed
# list into a package, and examples/cmake/check.sh compares the two. The macOS and iOS lists were printed on macOS; the
# others come from the Rust standard library and the dependencies of the crate, and were not printed here.
function(sdrkit_system_libraries triple out)
    if(triple MATCHES "-apple-darwin")
        set(libs "-framework AudioToolbox" "-framework IOKit" "-framework Security" "-framework CoreFoundation"
            "-framework Accelerate" iconv System c m)
    elseif(triple MATCHES "-apple-")
        set(libs "-framework AudioToolbox" "-framework Security" "-framework CoreFoundation" "-framework Accelerate"
            iconv System c m)
    elseif(triple MATCHES "-linux-android")
        set(libs dl log unwind m c)
    elseif(triple MATCHES "-linux-gnu")
        set(libs gcc_s util rt pthread m dl c)
    elseif(triple MATCHES "-linux-musl")
        set(libs c)
    elseif(triple MATCHES "-windows-msvc")
        # nusb and socket2 call setupapi, cfgmgr32 and winusb; the names stay listed in case a static library does
        # not carry those imports itself.
        set(libs kernel32.lib advapi32.lib ntdll.lib userenv.lib ws2_32.lib dbghelp.lib bcrypt.lib
            setupapi.lib cfgmgr32.lib winusb.lib)
    elseif(triple MATCHES "-windows-gnu")
        set(libs kernel32 advapi32 ntdll userenv ws2_32 dbghelp bcrypt setupapi cfgmgr32 winusb gcc_eh pthread)
    else()
        set(libs "")
    endif()
    set(${out} "${libs}" PARENT_SCOPE)
endfunction()

# Appends to `out` the import libraries that the crates windows_<arch>_msvc and windows_<arch>_gnu carry. The static
# library of a Windows target names one of them (such as windows.0.52.0.lib) and the linker must find it.
# `cargo` and `manifest` are the cargo program and the Cargo.toml of the workspace.
function(sdrkit_windows_import_libraries cargo manifest triple out)
    set(found "${${out}}")
    if(NOT triple MATCHES "-windows-")
        return()
    endif()
    execute_process(
        COMMAND "${cargo}" metadata --format-version 1 --filter-platform "${triple}" --manifest-path "${manifest}"
        OUTPUT_VARIABLE metadata ERROR_VARIABLE error RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(WARNING "sdrkit: cargo metadata failed: ${error}")
        return()
    endif()
    string(REPLACE "\\\\" "/" metadata "${metadata}")
    string(REGEX MATCHALL "\"manifest_path\":\"[^\"]*/windows_[a-z0-9_]+_(msvc|gnu|gnullvm)-[^\"]*/Cargo.toml\"" paths
        "${metadata}")
    foreach(item IN LISTS paths)
        string(REGEX REPLACE "^\"manifest_path\":\"(.*)/Cargo.toml\"$" "\\1" dir "${item}")
        if(triple MATCHES "-windows-msvc")
            file(GLOB libs "${dir}/lib/windows*.lib")
        else()
            file(GLOB libs "${dir}/lib/libwindows*.a")
        endif()
        list(APPEND found ${libs})
    endforeach()
    list(REMOVE_DUPLICATES found)
    set(${out} "${found}" PARENT_SCOPE)
endfunction()

# Sets `out` to the system libraries `libs` (CMake link items) as pkg-config link flags.
function(sdrkit_pkg_config_flags libs out)
    set(flags "")
    foreach(item IN LISTS libs)
        if(item MATCHES "^-" OR item MATCHES "\\.lib$" OR IS_ABSOLUTE "${item}")
            string(APPEND flags " ${item}")
        elseif(item MATCHES "^lib(.+)\\.a$")
            string(APPEND flags " -l${CMAKE_MATCH_1}")
        else()
            string(APPEND flags " -l${item}")
        endif()
    endforeach()
    string(STRIP "${flags}" flags)
    set(${out} "${flags}" PARENT_SCOPE)
endfunction()
