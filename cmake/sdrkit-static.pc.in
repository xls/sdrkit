prefix=${pcfiledir}/@SDRKIT_PC_TO_PREFIX@
includedir=${prefix}/@SDRKIT_INSTALL_INCLUDEDIR@
libdir=${prefix}/@SDRKIT_INSTALL_LIBDIR@
datadir=${prefix}/@SDRKIT_INSTALL_DATADIR@

Name: sdrkit-static
Description: A software-defined radio engine (static library)
Version: @SDRKIT_VERSION@
Cflags: -I${includedir}
Libs: ${libdir}/@SDRKIT_STATIC_NAME@ -L${libdir} @SDRKIT_PC_SYSTEM_LIBS@
