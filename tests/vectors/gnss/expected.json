  {
   "id": "A1",
   "what": "Search every GPS PRN 1-32 over Doppler -10..+10 kHz with 16 ms (8 coherent pairs of 2 ms) on the first 0.5 s",
   "expected": "every PRN in present.GPS is found; no other PRN is found",
   "tolerance": {
    "doppler_hz": 300,
    "first_code_epoch_sample": 1.5
   }
  },
  {
   "id": "A2",
   "what": "Search QZSS PRN 193-202 and SBAS PRN 120-158 the same way",
   "expected": "exactly present.QZSS and present.SBAS are found",
   "tolerance": {
    "doppler_hz": 300,
    "first_code_epoch_sample": 1.5
   }
  },
  {
   "id": "A3",
   "what": "Search Galileo E1-B 1-36 with BOC(1,1) replicas, window centred on +2500 Hz +-6 kHz, 16 ms non-coherent (4 code periods)",
   "expected": "every Galileo satellite with C/N0 >= 34 dB-Hz in present.Galileo is found; at most one of the weaker ones (E03, E10, E19, about 33.5 dB-Hz) may be missed; nothing that is not present",
   "tolerance": {
    "doppler_hz": 150,
    "first_code_epoch_sample": 1.0
   }
  },
  {
   "id": "A4",
   "what": "A false-alarm probability of 1e-3 per satellite search",
   "expected": "over A1 to A3, at most 1 false detection"
  }
 ],
 "tracking_tests": [
  {
   "id": "T1",
   "what": "Start a channel on each A1/A2 detection and track to the end of the recording",
   "expected": "every GPS, QZSS and SBAS channel reaches carrier lock; its C/N0 estimate at the end is within the tolerance of cn0_dbhz; its Doppler at 0.75 s is within the tolerance",
   "tolerance": {
    "cn0_db": 2.5,
    "doppler_hz_locked": 10.0,
