# The interface of the stack family dvbs2. The registry test of the family writes this file.
family dvbs2 version=2.0
shape.Dvbs2Fields since=1.0
shape.Dvbs2Fields.standard type=choice(dvbs,dvbs2) unit= optional=yes since=1.0
