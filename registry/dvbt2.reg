# The interface of the stack family dvbt2. The registry test of the family writes this file.
family dvbt2 version=1.3
uses.mpegts major=1 since=1.0
uses.ipcast major=1 since=1.0
shape.Dvbt2Fields since=1.0
shape.Dvbt2Fields.detection type=choice(searching,p1,l1,flowing) unit= optional=no since=1.0
shape.Dvbt2Fields.fft type=choice(1k,2k,4k,8k,16k,32k) unit= optional=yes since=1.0
shape.Dvbt2Fields.guard type=choice(1/32,1/16,1/8,1/4,1/128,19/128,19/256) unit= optional=yes since=1.0
shape.Dvbt2Fields.pilot_pattern type=choice(pp1,pp2,pp3,pp4,pp5,pp6,pp7,pp8) unit= optional=yes since=1.0
shape.Dvbt2Fields.extended_carriers type=bool unit= optional=yes since=1.0
shape.Dvbt2Fields.miso type=bool unit= optional=yes since=1.0
shape.Dvbt2Fields.profile type=choice(base,lite) unit= optional=yes since=1.0
shape.Dvbt2Fields.l1_modulation type=choice(bpsk,qpsk,16qam,64qam,256qam) unit= optional=yes since=1.0
shape.Dvbt2Fields.cell_id type=i64 unit= optional=yes since=1.0
shape.Dvbt2Fields.network_id type=i64 unit= optional=yes since=1.0
shape.Dvbt2Fields.t2_system_id type=i64 unit= optional=yes since=1.0
shape.Dvbt2Fields.frames_per_superframe type=i64 unit= optional=yes since=1.0
shape.Dvbt2Fields.data_symbols type=i64 unit= optional=yes since=1.0
shape.Dvbt2Fields.frame_length type=duration unit=s optional=yes since=1.0
shape.Dvbt2Fields.t2_frames type=i64 unit= optional=no since=1.0
shape.Dvbt2Fields.l1_errors type=i64 unit= optional=no since=1.0
shape.Dvbt2Fields.plp type=i64 unit= optional=yes since=1.0
shape.Dvbt2Fields.common_plp type=i64 unit= optional=yes since=1.0
shape.Dvbt2Fields.ldpc_iterations type=f64 unit= optional=no since=1.0
shape.Dvbt2Fields.net_rate_bit_s type=f64 unit=bit/s optional=yes since=1.0
shape.Dvbt2Fields.problem type=choice(tfs,frame_shape,l1_post_size,no_such_plp,no_data_plp,unknown_coding) unit= optional=yes since=1.0
shape.Dvbt2Fields.offset_hz type=hz unit=Hz optional=yes since=1.0
shape.Dvbt2Fields.snr_db type=f64 unit=dB optional=yes since=1.0
shape.Dvbt2Fields.frames_ok type=i64 unit= optional=no since=1.0
shape.Dvbt2Fields.frames_bad type=i64 unit= optional=no since=1.0
shape.Dvbt2Fields.bits_corrected type=i64 unit= optional=no since=1.0
shape.Dvbt2TxFields since=1.2
shape.Dvbt2TxFields.transmitting type=bool unit= optional=no since=1.2
shape.Dvbt2TxFields.tx_freq_hz type=hz unit=Hz optional=yes since=1.2
shape.Dvbt2TxFields.tx_bitrate_bps type=f64 unit=bit/s optional=no since=1.2
shape.Dvbt2TxFields.tx_packets type=i64 unit= optional=no since=1.2
shape.Dvbt2TxFields.tx_nulls type=i64 unit= optional=no since=1.2
shape.Dvbt2TxFields.tx_queue type=i64 unit= optional=no since=1.2
shape.Dvbt2TxFields.tx_queue_s type=duration unit=s optional=no since=1.2
shape.Dvbt2TxFields.tx_pcr_restamped type=i64 unit= optional=no since=1.2
shape.Dvbt2TxFields.tx_frame_s type=duration unit=s optional=yes since=1.2
shape.Dvbt2TxFields.tx_fec_blocks type=i64 unit= optional=yes since=1.2
shape.Dvbt2TxFields.tx_problem type=text unit= optional=yes since=1.2
shape.Dvbt2PlpRow since=1.0
shape.Dvbt2PlpRow.plp_id type=i64 unit= optional=no since=1.0
shape.Dvbt2PlpRow.plp_type type=choice(common,data1,data2,reserved) unit= optional=no since=1.0
shape.Dvbt2PlpRow.payload type=choice(gfps,gcs,gse,ts,reserved) unit= optional=no since=1.0
shape.Dvbt2PlpRow.modulation type=choice(bpsk,qpsk,16qam,64qam,256qam) unit= optional=yes since=1.0
shape.Dvbt2PlpRow.code_rate type=choice(1/2,3/5,2/3,3/4,4/5,5/6,1/3,2/5,1/4) unit= optional=yes since=1.0
shape.Dvbt2PlpRow.fec_frame_bits type=i64 unit=bits optional=yes since=1.0
shape.Dvbt2PlpRow.rotated type=bool unit= optional=no since=1.0
shape.Dvbt2PlpRow.fec_blocks type=i64 unit= optional=no since=1.0
shape.Dvbt2PlpRow.group_id type=i64 unit= optional=no since=1.0
shape.Dvbt2PlpRow.time_interleaving type=choice(off,blocks,frames) unit= optional=no since=1.0
shape.Dvbt2PlpRow.time_il_length type=i64 unit= optional=no since=1.0
