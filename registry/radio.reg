# The interface of the stack family radio. The registry test of the family writes this file.
family radio version=1.0
shape.RadioFields since=1.0
shape.RadioFields.state type=choice(idle,connecting,up,away,stopped) unit= optional=no since=1.0
shape.RadioFields.rate_hz type=hz unit=Hz optional=yes since=1.0
shape.RadioFields.centre_hz type=hz unit=Hz optional=yes since=1.0
shape.RadioFields.samples type=i64 unit= optional=no since=1.0
shape.RadioFields.dropped type=i64 unit= optional=no since=1.0
shape.RadioFields.buffer_pct type=f64 unit=% optional=yes since=1.0
shape.RadioFields.radio_lost type=i64 unit= optional=yes since=1.0
shape.RadioFields.link_down type=i64 unit= optional=yes since=1.0
shape.RadioFields.delivered_pct type=f64 unit=% optional=yes since=1.0
shape.RadioFields.problem type=text unit= optional=yes since=1.0
shape.ConnectedEvent since=1.0
shape.ConnectedEvent.source type=text unit= optional=yes since=1.0
shape.ConnectedEvent.text type=text unit= optional=yes since=1.0
shape.ConnectedEvent.family type=choice(aircraft,vessel,aprs,pager,sonde,broadcast,voice,message,sensor,satellite,receiver,alert,other) unit= optional=no since=1.0
shape.LostEvent since=1.0
shape.LostEvent.source type=text unit= optional=yes since=1.0
shape.LostEvent.text type=text unit= optional=yes since=1.0
shape.LostEvent.family type=choice(aircraft,vessel,aprs,pager,sonde,broadcast,voice,message,sensor,satellite,receiver,alert,other) unit= optional=no since=1.0
shape.OverflowEvent since=1.0
shape.OverflowEvent.source type=text unit= optional=yes since=1.0
shape.OverflowEvent.text type=text unit= optional=yes since=1.0
shape.OverflowEvent.family type=choice(aircraft,vessel,aprs,pager,sonde,broadcast,voice,message,sensor,satellite,receiver,alert,other) unit= optional=no since=1.0
shape.RestartEvent since=1.0
shape.RestartEvent.source type=text unit= optional=yes since=1.0
shape.RestartEvent.text type=text unit= optional=yes since=1.0
shape.RestartEvent.family type=choice(aircraft,vessel,aprs,pager,sonde,broadcast,voice,message,sensor,satellite,receiver,alert,other) unit= optional=no since=1.0
radio since=1.0
radio.fields.RadioFields since=1.0
radio.event.radio.connected fields=ConnectedEvent since=1.0
radio.event.radio.lost fields=LostEvent since=1.0
radio.event.radio.overflow fields=OverflowEvent since=1.0
radio.event.radio.restart fields=RestartEvent since=1.0
radio.setting.centre_hz type=hz unit=Hz since=1.0
radio.setting.rate type=hz unit=Hz since=1.0
radio.setting.bandwidth type=hz unit=Hz since=1.0
radio.setting.gain type=f64 unit=dB since=1.0
radio.setting.agc type=bool unit= since=1.0
radio.setting.rate_exact type=bool unit= since=1.0
radio.setting.bias_tee type=bool unit= since=1.0
radio.command.reconnect args= reply= since=1.0
