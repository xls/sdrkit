scan.command.survey args=session:text;start_hz:hz;stop_hz:hz;span_hz:hz;watch:text;above:f64?;stack:text?;dwell_s:duration?;total_s:duration?;rate_hz:hz?;dry:bool? reply=channels:i64;kind:choice(none,activity,channels,span,survey);dwell_s:duration;pass_s:duration;total_s:duration;passes:f64;visit_s:duration;span_pass_s:duration since=1.2
