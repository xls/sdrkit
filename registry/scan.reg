# The interface of the stack family scan. The registry test of the family writes this file.
family scan version=2.1
shape.ScanFields since=1.0
shape.ScanFields.state type=choice(idle,settle,listen,hold,hang,paused,test,done,locked,look) unit= optional=no since=1.0
shape.ScanFields.kind type=choice(none,activity,channels,span,survey) unit= optional=no since=1.0
shape.ScanFields.index type=i64 unit= optional=yes since=1.0
