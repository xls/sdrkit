scan since=1.0
scan.fields.ScanFields since=1.0
scan.table.hits row=HitRow cap=10000 since=1.1
scan.table.candidates row=CandidateRow cap=1000 since=1.2
scan.table.occupied row=OccupiedRow cap=1000 since=2.1
scan.setting.settle type=duration unit=s since=1.0
scan.setting.dwell type=duration unit=s since=1.0
scan.setting.hang type=duration unit=s since=1.0
scan.setting.max_hold type=duration unit=s since=1.0
scan.setting.stop_on type=choice(squelch,snr,level,lock,squelch_or_lock) unit= since=1.0
scan.setting.threshold_db type=f64 unit=dB since=1.0
scan.setting.priority_interval type=duration unit=s since=1.0
