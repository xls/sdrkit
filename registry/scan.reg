shape.ScanFields.steps type=i64 unit= optional=yes since=1.0
shape.ScanFields.found type=i64 unit= optional=yes since=1.0
shape.ScanFields.end type=choice(none,passes_done,all_locked_out,nothing_to_scan,stopped,complete,time_over) unit= optional=no since=1.0
shape.ScanFields.session type=text unit= optional=yes refers_to=sessions since=1.0
shape.ScanFields.total type=i64 unit= optional=yes since=1.0
shape.ScanFields.time_left_s type=duration unit=s optional=yes since=1.2
shape.ScanFields.pass_s type=duration unit=s optional=yes since=1.2
